# Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_BOT_TOKEN=
# Discord Developer Portal -> your app -> General Information -> Application ID
DISCORD_APP_ID=
# Optional: force a specific log channel id (default: a channel named bot-logging)
# LOG_CHANNEL_ID=
# Riot Games API key for /verify (https://developer.riotgames.com — dev keys
# expire every 24h; the bot re-reads this file on every call, so just edit it).
# RIOT_API_KEY=
# Where 🎉 promotion celebrations post (default: the bot-logging channel).
# CELEBRATE_CHANNEL_ID=
# "First time this split" dedup bucket — bump at each ranked split + restart.
# SPLIT_KEY=2026-split-2
